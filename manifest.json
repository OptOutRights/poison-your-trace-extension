{
  "manifest_version": 2,
  "name": "Poison your Trace",
  "version": "0.1.1",
  "description": "Stops your separate activities from being joined into one identity. Every site gets its own container and your browser fingerprint is uniformized.",
  "browser_specific_settings": {
    "gecko": {
      "id": "poisonyourtrace@optoutrights.org",
      "update_url": "https://github.com/OptOutRights/poison-your-trace-web-extension/releases/latest/download/updates.json",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "contextualIdentities",
    "cookies",
    "storage",
    "tabs",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["dist/background.js"]
  },
  "browser_action": {
    "default_title": "Poison your Trace",
    "default_popup": "popup.html",
    "default_icon": "icons/syringe.svg"
  },
  "page_action": {
    "default_title": "Poison your Trace, what this site sees",
    "default_popup": "popup.html",
    "default_icon": "icons/syringe.svg",
    "show_matches": ["http://*/*", "https://*/*"]
  },
  "icons": {
    "16": "icons/syringe.svg",
    "48": "icons/syringe.svg",
    "96": "icons/syringe.svg"
  }
}
